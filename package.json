{
  "name": "ultimate-telegram-mini-app",
  "version": "2.0.0",
  "description": "Ultimate Telegram Mini App - 10000x Better Gaming Experience with 7 Game Modes, Real-time Multiplayer, Social Features, and Advanced Economy",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prestart": "prisma db push",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "build": "npm run prisma:generate",
    "postinstall": "npm run prisma:generate",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "telegram",
    "mini-app",
    "game",
    "multiplayer",
    "real-time",
    "gambling",
    "luck",
    "slots",
    "casino",
    "social",
    "achievement",
    "leaderboard",
    "tournament"
  ],
  "author": "Ultimate Gaming Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "uuid": "^9.0.1",
    "dayjs": "^1.11.10",
    "bull": "^4.12.0",
    "node-cron": "^3.0.3",
    "axios": "^1.6.5",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "validator": "^13.11.0",
    "crypto-js": "^4.2.0",
    "lodash": "^4.17.21",
    "nanoid": "^3.3.7",
    "sanitize-html": "^2.11.0",
    "prisma": "^5.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@types/node": "^20.10.6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mpython77/telegram-mini-app-"
  }
}