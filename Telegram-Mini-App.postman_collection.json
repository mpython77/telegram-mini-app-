        {
          "name": "Get Game History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/game/{{userId}}/history?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "{{userId}}", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
