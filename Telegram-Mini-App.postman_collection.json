{
  "info": {
    "name": "Telegram Mini App API",
    "description": "Complete API collection for Telegram Mini App with 7 game modes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Init User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegramId\": 123456789,\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"username\": \"johndoe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/init",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "init"]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/{{userId}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "{{userId}}", "profile"]
            }
          }
        },
        {
          "name": "Get User Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/{{userId}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "{{userId}}", "stats"]
            }
          }
        },
        {
          "name": "Get Referrals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/{{userId}}/referrals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "{{userId}}", "referrals"]
            }
          }
        }
      ]
    },
