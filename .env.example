# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_VERSION=v1

# ==============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================
# Railway auto-provides DATABASE_URL
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/telegram_app?schema=public"

# Database Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==============================================
# REDIS CONFIGURATION
# ==============================================
# Railway auto-provides REDIS_URL
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# Redis Cache TTL (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET="change-this-to-super-secret-key-min-32-characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-refresh-secret-key-min-32-characters"
JWT_REFRESH_EXPIRES_IN="30d"

# ==============================================
# TELEGRAM BOT CONFIGURATION
# ==============================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"
TELEGRAM_BOT_USERNAME="YourBotUsername"
TELEGRAM_WEBAPP_URL="https://your-app.railway.app"

# ==============================================
# ADMIN CONFIGURATION
# ==============================================
ADMIN_SECRET_KEY="change-this-admin-secret-key"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
ADMIN_EMAIL="admin@example.com"

# ==============================================
# GAME CONFIGURATION
# ==============================================
# Luck Game
LUCK_MIN_VALUE=1
LUCK_MAX_VALUE=100
LUCK_MIN_BET=10
LUCK_MAX_BET=10000

# Multiplier Ranges
MULTIPLIER_MIN=0.1
MULTIPLIER_MAX=100.0
MULTIPLIER_JACKPOT=1000.0

# House Edge (percentage)
HOUSE_EDGE=2.5

# Daily Limits
DAILY_FREE_SPINS=5
DAILY_CHALLENGE_COUNT=3
DAILY_QUEST_COUNT=5

# ==============================================
# ECONOMY CONFIGURATION
# ==============================================
# Starting Balance
STARTING_COINS=1000
STARTING_GEMS=100

# Currency Conversion
COINS_TO_GEMS_RATE=100
GEMS_TO_COINS_RATE=100

# Referral Rewards
REFERRAL_REWARD_COINS=500
REFERRAL_REWARD_GEMS=50
REFERRED_USER_REWARD_COINS=200

# Level System
XP_PER_GAME=10
XP_MULTIPLIER_WIN=2
XP_MULTIPLIER_STREAK=1.5

# ==============================================
# SOCIAL FEATURES
# ==============================================
MAX_FRIENDS=200
MAX_CLAN_MEMBERS=50
MAX_GIFT_VALUE_COINS=5000
MAX_GIFT_VALUE_GEMS=100

# Chat Settings
MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW=60

# ==============================================
# MULTIPLAYER CONFIGURATION
# ==============================================
MULTIPLAYER_ENABLED=true
MAX_ROOM_PLAYERS=10
ROOM_TIMEOUT_SECONDS=300
MATCHMAKING_TIMEOUT=60

# ==============================================
# TOURNAMENT SETTINGS
# ==============================================
TOURNAMENT_ENTRY_FEE_MIN=100
TOURNAMENT_ENTRY_FEE_MAX=10000
TOURNAMENT_PRIZE_POOL_PERCENTAGE=90
TOURNAMENT_MAX_PARTICIPANTS=1000

# ==============================================
# SEASON & BATTLE PASS
# ==============================================
SEASON_DURATION_DAYS=90
BATTLE_PASS_PRICE_GEMS=1000
BATTLE_PASS_LEVELS=100

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GAME_WINDOW_MS=60000
RATE_LIMIT_GAME_MAX=20

# ==============================================
# SECURITY SETTINGS
# ==============================================
BCRYPT_ROUNDS=10
SESSION_SECRET="change-this-session-secret"
CORS_ORIGIN="*"
ALLOWED_ORIGINS="https://your-domain.com,https://t.me"

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# ==============================================
# EXTERNAL SERVICES (OPTIONAL)
# ==============================================
# AWS S3 for file storage
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# SendGrid for emails
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Analytics
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Payment Gateway (Future)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_MULTIPLAYER=true
FEATURE_TOURNAMENTS=true
FEATURE_CLANS=true
FEATURE_SHOP=true
FEATURE_BATTLE_PASS=true
FEATURE_REFERRALS=true
FEATURE_CHAT=true
FEATURE_GIFTS=true
FEATURE_ANALYTICS=true

# ==============================================
# MAINTENANCE MODE
# ==============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please try again later."

# ==============================================
# WEBHOOK CONFIGURATION
# ==============================================
WEBHOOK_SECRET=""
WEBHOOK_ENABLED=false

# ==============================================
# MONITORING & ALERTS
# ==============================================
SENTRY_DSN=""
SLACK_WEBHOOK_URL=""
ALERT_EMAIL=""

# ==============================================
# PERFORMANCE
# ==============================================
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
RESPONSE_CACHE_ENABLED=true
